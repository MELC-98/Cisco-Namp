# ============================================================
# Cisco NAMP — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Application ---
APP_NAME="Cisco NAMP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cisco_namp
DB_USERNAME=namp_user
DB_PASSWORD=change_me_db_password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Laravel Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1
SESSION_DOMAIN=localhost
SESSION_DRIVER=redis
SESSION_LIFETIME=480

# --- Admin Seed Account ---
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@cisco-namp.local
ADMIN_PASSWORD=change_me_admin_password

# --- FastAPI Automation Service ---
AUTOMATION_API_URL=http://automation:8001
AUTOMATION_API_KEY=change_me_automation_api_key

# --- Backup Storage ---
BACKUP_STORAGE_PATH=/app/storage/backups

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
